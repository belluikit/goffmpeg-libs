  --prefix=/darwin_amd64 --extra-cflags=-fPIC --enable-pic --disable-autodetect --disable-programs --disable-doc --disable-debug --disable-encoders --disable-muxers --disable-avfilter --enable-swscale --enable-swresample --enable-network --arch=x86_64 --target-os=darwin --enable-cross-compile --enable-securetransport --enable-videotoolbox --enable-avdevice --enable-avfoundation --cc='clang -arch x86_64 -mmacosx-version-min=11.0' --disable-decoders --disable-demuxers --disable-parsers --disable-bsfs --disable-hwaccels --disable-indevs --enable-demuxer='mp3,wav,mov,hls,mpegts,aac,ac3,eac3' --enable-decoder='mp3float,pcm_s16le,pcm_s24le,pcm_s32le,pcm_f32le,pcm_f64le,pcm_u8,h264,aac,rawvideo,mjpeg' --enable-parser='mpegaudio,h264,aac,ac3' --enable-hwaccel=h264_videotoolbox --enable-indev=avfoundation --enable-shared --disable-static --build-suffix=-goffmpeg --install-name-dir='@rpath'

